# quick embed demo
# load a few descriptions, run embeddings, cosine top-3

import json
import numpy as np
import pandas as pd
from services.embeddings.text_embedder import TextEmbedder

csv_path = 'data/dataset.csv'
df = pd.read_csv(csv_path, encoding='latin-1').drop_duplicates()
texts = df['Description'].astype(str).head(200).tolist()

te = TextEmbedder()
emb = te.encode(texts)

q = texts[0]
qv = te.encode([q])[0]
sims = (emb @ qv) / (np.linalg.norm(emb, axis=1) * np.linalg.norm(qv) + 1e-12)
idx = np.argsort(sims)[-3:][::-1]

print('query:', q)
print('\n'.join([f'{i}: {texts[i]}' for i in idx]))
