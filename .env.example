# Pinecone Configuration (Latest API v7.3.0+)
# Get your API key from https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here

# Optional: Set to 0 to disable oneDNN optimizations if you see numerical differences
TF_ENABLE_ONEDNN_OPTS=1

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True